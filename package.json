{
  "name": "login-parking",
  "version": "1.0.0",
  "description": "Parking management API (Express 5, Sequelize, PostgreSQL): partners, parkings, vehicle entries/exits, rankings and daily e-mail reports.",
  "main": "app.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "cross-env NODE_ENV=development nodemon app.js",
    "test": "cross-env NODE_ENV=test jest --selectProjects unit",
    "test:e2e": "cross-env NODE_ENV=test jest --selectProjects e2e --runInBand",
    "test:all": "cross-env NODE_ENV=test jest --runInBand",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --coverage",
    "db:migrate": "node src/database/cli.js migrate",
    "db:migrate:down": "node src/database/cli.js migrate:down",
    "db:status": "node src/database/cli.js migrate:status",
    "db:seed:admin": "node src/database/cli.js seed:admin"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.872.0",
    "amqplib": "^0.10.8",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "umzug": "^3.8.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.0.5",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/test/unit/**/*.test.js"
        ],
        "setupFiles": [
          "<rootDir>/test/support/unit-env.js"
        ]
      },
      {
        "displayName": "e2e",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/test/e2e/**/*.test.js"
        ],
        "setupFiles": [
          "<rootDir>/test/support/e2e-env.js"
        ]
      }
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/database/cli.js"
    ],
    "coverageReporters": [
      "text-summary",
      "json-summary",
      "text"
    ]
  }
}
