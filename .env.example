# Copy to .env (or .env.<NODE_ENV>) and fill in. Never commit real values.
# Required: JWT_KEY and either DATABASE_URL or DB_NAME/DB_USER/DB_PASSWORD.

NODE_ENV=development
PORT=3000
# Calendar days, weeks and report times are computed in this IANA time zone.
APP_TIMEZONE=America/Bogota
# Comma-separated allowed origins; empty allows any origin.
CORS_ORIGINS=
LOG_LEVEL=info

# Authentication (JWT_KEY: at least 32 random characters)
JWT_KEY=
JWT_EXPIRES_IN=6h
BCRYPT_ROUNDS=10

# Admin created at startup when missing (an existing user is never modified)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin

# Database: DATABASE_URL (SSL on by default) or the DB_* variables
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=
# Apply pending migrations at startup (default true)
DB_MIGRATE=true
# Create DB_NAME if missing (default true outside production)
DB_CREATE_IF_MISSING=
DB_LOGGING=false

# Daily report e-mail (sent through api-mail)
REPORTS_ENABLED=true
# node-cron expression (with seconds) in APP_TIMEZONE; reports the previous day
REPORTS_CRON=0 5 0 * * *
APP_SUBJECT=Reporte diario de parqueaderos
# rabbitmq (queue consumed by api-mail) or http (POST /mail/send on api-mail)
MAIL_TRANSPORT=rabbitmq
MAIL_API_URL=
# Same value as MAIL_API_KEY in api-mail (sent as the x-api-key header)
MAIL_API_KEY=
MAIL_API_TIMEOUT_MS=10000
RABBITMQ_URL=amqp://localhost
QUEUE_NAME=email_queue
RABBITMQ_PUBLISH_RETRIES=5
RABBITMQ_RETRY_DELAY_MS=1000

# Cloudflare R2 (report attachments)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_BUCKET_ACCESS_KEY=
R2_BUCKET_SECRET_KEY=
R2_BUCKET_REGION=auto

# End-to-end tests only (the database is dropped and re-created; its name must contain "test")
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=postgres
TEST_DB_PASSWORD=
TEST_DB_NAME=login_parking_test
